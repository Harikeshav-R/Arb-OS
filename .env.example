POLYMARKET_API_KEY=your_api_key_here
PASSPHRASE=your_passphrase_here
SECRET=your_secret_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/arbos
REDIS_URL=redis://localhost:6379

# IBM watsonx.ai (Brain / Tier 2)
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_MODEL_ID=mistralai/mistral-large

# Brain tuning
BRAIN_LLM_TEMPERATURE=0.0
BRAIN_LLM_MAX_TOKENS=1024
BRAIN_CONFIDENCE_THRESHOLD=0.7
BRAIN_GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
BRAIN_GAMMA_MIN_VOLUME=1000
BRAIN_GAMMA_FETCH_LIMIT=100
